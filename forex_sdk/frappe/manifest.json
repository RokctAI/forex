{
  "name": "rforex",
  "version": "0.1.0",
  "description": "Modular backend package for forex_sdk (versioned strategy specs, pinned user assignments, resolved risk parameters, broker credentials, entitlement)",
  "app_type": {
    "tenant": {
      "dependencies": [
        "base",
        "auth",
        "users",
        "subscriptions"
      ],
      "_comment_dependencies": "Frappe-module dependencies, not Dart ones. `base` supplies the app shell and shared settings; `auth`/`users` own the User rows every DocType here links to; `subscriptions` owns the payment flow that calls record_subscription_period. rforex does not import any of them at module level — the coupling is through User links and a whitelisted call from the payment side.",
      "hooks": {
        "whitelisted_methods": {
          "{app_name}.api.forex.list_strategies": "{app_name}.rforex.tenant.rforex.api.strategy.list_strategies",
          "{app_name}.api.forex.get_strategy": "{app_name}.rforex.tenant.rforex.api.strategy.get_strategy",
          "{app_name}.api.forex.pin_version": "{app_name}.rforex.tenant.rforex.api.strategy.pin_version",
          "{app_name}.api.forex.set_active": "{app_name}.rforex.tenant.rforex.api.strategy.set_active",
          "{app_name}.api.forex.dashboard": "{app_name}.rforex.tenant.rforex.api.account.dashboard",
          "{app_name}.api.forex.history": "{app_name}.rforex.tenant.rforex.api.account.history",
          "{app_name}.api.forex.margin_thresholds": "{app_name}.rforex.tenant.rforex.api.account.margin_thresholds",
          "{app_name}.api.forex.my_risk_profile": "{app_name}.rforex.tenant.rforex.api.risk.my_risk_profile",
          "{app_name}.api.forex.available_presets": "{app_name}.rforex.tenant.rforex.api.risk.available_presets",
          "{app_name}.api.forex.set_risk_preset": "{app_name}.rforex.tenant.rforex.api.risk.set_preset",
          "{app_name}.api.forex.credential_status": "{app_name}.rforex.tenant.rforex.api.credential.credential_status",
          "{app_name}.api.forex.store_credentials": "{app_name}.rforex.tenant.rforex.api.credential.store_credentials",
          "{app_name}.api.forex.refresh_credentials": "{app_name}.rforex.tenant.rforex.api.credential.refresh_credentials",
          "{app_name}.api.forex.revoke_credentials": "{app_name}.rforex.tenant.rforex.api.credential.revoke_credentials",
          "{app_name}.api.forex.my_entitlements": "{app_name}.rforex.tenant.rforex.api.entitlement.my_entitlements",
          "{app_name}.api.forex.record_subscription_period": "{app_name}.rforex.tenant.rforex.api.entitlement.record_subscription_period"
        },
        "scheduler_events": {},
        "doc_events": {},
        "fixtures": [
          {
            "dt": "DocType",
            "filters": [
              [
                "name",
                "in",
                [
                  "Forex Strategy",
                  "Forex Strategy Version",
                  "Forex User Strategy",
                  "Forex Risk Profile",
                  "Forex Broker Credential",
                  "Forex Subscription Period"
                ]
              ]
            ]
          }
        ]
      }
    },
    "control": {}
  }
}
