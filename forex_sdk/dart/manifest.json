{
  "name": "forex_sdk",
  "version": "0.1.0",
  "home_sdk": true,
  "_comment_home_sdk": "forex_sdk is the home SDK of its composition (composer/forex.json) — it owns the landing surface, so the app_routes entry below overrides replaceMainRoute to the strategy catalog. At most one SDK per app may claim this.",
  "home_page": "templates/routes/forex_route_pages.dart",
  "installs": [
    {
      "from": "templates/routes/forex_route_pages.dart",
      "to": "lib/presentation/routes/forex_route_pages.dart"
    }
  ],
  "_comment_installs": "One entry only. forex_route_pages.dart is HOST glue: it is the single file allowed to import more than one feature SDK, because it holds the adapters that satisfy forex's consumer-owned interfaces from wallet_sdk/subscriptions_sdk (ADR-005). It ships as a template rather than inside lib/ for exactly that reason.",
  "routes": [
    {
      "path": "/forex-strategies",
      "page": "ForexStrategiesRoute.page",
      "type": "MaterialRoute",
      "import": "package:${package}/presentation/routes/forex_route_pages.dart"
    },
    {
      "path": "/forex-risk",
      "page": "ForexRiskRoute.page",
      "type": "MaterialRoute",
      "import": "package:${package}/presentation/routes/forex_route_pages.dart"
    },
    {
      "path": "/forex-account",
      "page": "ForexAccountRoute.page",
      "type": "MaterialRoute",
      "import": "package:${package}/presentation/routes/forex_route_pages.dart"
    }
  ],
  "app_routes": [
    {
      "method": "replaceMainRoute",
      "body": "context.router.replace(ForexStrategiesRoute());",
      "imports": [
        "import 'package:${package}/presentation/routes/app_router.dart';"
      ]
    }
  ],
  "tr_keys": {
    "strategies": "strategies",
    "risk": "risk",
    "account": "account",
    "nothingToShowYet": "nothing_to_show_yet_pull_to_refresh",
    "notAvailableYet": "not_available_yet",
    "needsActiveSubscription": "needs_an_active_subscription",
    "seePlans": "see_plans",
    "upgrade": "upgrade",
    "includedWith": "included_with",
    "version": "version",
    "whatThisMeans": "what_this_means",
    "mostOneTradeCanLose": "most_one_trade_can_lose",
    "stopsForTheDayAt": "stops_for_the_day_at",
    "haltsAltogetherAt": "halts_altogether_at",
    "positionsOpenAtOnce": "positions_open_at_once",
    "connectAccountToSeeAmounts": "connect_a_trading_account_to_see_these_as_amounts",
    "percentagesAreOfEquity": "percentages_are_of_your_account_equity",
    "applyTheseLimits": "apply_these_limits",
    "saving": "saving",
    "couldNotSaveLimitsUnchanged": "could_not_save_your_limits_are_unchanged",
    "currentlyApplied": "currently_applied",
    "conservative": "conservative",
    "balanced": "balanced",
    "aggressive": "aggressive",
    "balance": "balance",
    "equity": "equity",
    "usedMargin": "used_margin",
    "freeMargin": "free_margin",
    "marginLevel": "margin_level",
    "openPositions": "open_positions",
    "noPositionsOpen": "no_positions_open",
    "marginLevelUndefined": "margin_level_is_undefined_with_no_positions_open",
    "figuresMayBeOutOfDate": "these_figures_may_be_out_of_date",
    "asOf": "as_of",
    "noBrokerConnected": "no_trading_account_connected",
    "connectAccount": "connect_a_trading_account",
    "accountFiguresUnavailable": "account_figures_are_unavailable_right_now",
    "botStoppedBlocked": "this_strategy_version_has_been_stopped",
    "botPaused": "paused",
    "botRunning": "running",
    "upgradeAvailable": "a_newer_version_is_available",
    "keepCurrentVersion": "keep_the_version_im_on"
  },
  "_comment_tr_keys": "User-visible strings. The account and version-status keys are declared here although their screen is not built yet — the dashboard page is deliberately unimplemented (no broker connector exists), and declaring the keys now means the translation pass does not have to run twice."
}
