# Build output
bin/
obj/
[Dd]ebug/
[Rr]elease/
*.user
*.suo

# cTrader Algo build artefacts
*.algo
*.algo.metadata

# The cTrader.Automate targets copy the built .algo into the local cTrader sources
# folder after every build. On a dev machine that is the point; in the repo it is noise.
cAlgo/

# IDE
.vs/
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Python (forex_sdk/frappe — the rforex module and its unittest runs)
__pycache__/
*.py[cod]

# Dart / Flutter (forex_sdk/dart). Scoped rather than global: a bare `build/`
# would also swallow any future directory of that name on the .NET side.
forex_sdk/dart/.dart_tool/
forex_sdk/dart/.packages
forex_sdk/dart/build/
forex_sdk/dart/pubspec.lock
